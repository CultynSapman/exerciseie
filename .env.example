# Google AI Studio API key (required): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
EXTRA_PROMPT=
AUTO_SAVE=false
# YTDLP_COOKIES_FILE=/config/cookies.txt

# Optional: enable the "Send to wger" export button.
# WGER_URL is your instance, e.g. https://wger.example.com (no trailing slash).
# The API key comes from wger -> user icon -> "API key"; the account must be
# allowed to contribute exercises (an admin account on your own instance works).
WGER_URL=
WGER_API_KEY=
